# ==============================================================================
# Multi-Tenant Ticket Booking Platform - Environment Configuration Example
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:5000

# Security & Cryptographic Tokens
# CRITICAL: Generate a strong 64-character secret in production using: openssl rand -hex 32
SIGNING_SECRET=multi_tenant_platform_secret_jwt_sign_key_2026
JWT_SECRET=super_secret_multi_tenant_jwt_signing_key_change_in_prod

# PostgreSQL Database (Neon / Supabase / Postgres)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ------------------------------------------------------------------------------
# Direct UPI Service Config (UpiService)
# ------------------------------------------------------------------------------
MERCHANT_UPI_ID=your_merchant_vpa@fbpe
MERCHANT_NAME=TicketBooking Platform
MERCHANT_MCC=5411
WEBHOOK_SECRET=upi_webhook_secret_platform_2026

# ------------------------------------------------------------------------------
# Default Platform Business Rules
# ------------------------------------------------------------------------------
DEFAULT_PLATFORM_COMMISSION_PAISE=200
GATEWAY_SURCHARGE_PERCENT=2.0
GST_ON_FEE_PERCENT=18.0
RESERVATION_HOLD_MINUTES=10

# ------------------------------------------------------------------------------
# WhatsApp Microservice
# ------------------------------------------------------------------------------
WHATSAPP_SERVICE_BASE_URL=https://whatsapp-service-ykiu.onrender.com
WHATSAPP_PHONE_PREFIX=0
WHATSAPP_ENABLED=true

# Optional Meta WhatsApp Cloud API Fallback Configuration
WHATSAPP_PHONE_NUMBER=+919876543210
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_TEMPLATE_NAME=purchase_receipt_1
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=verify_token_wa_2026

# Organizer WhatsApp Notification Target (Receives real-time new booking request alerts)
ORGANIZER_PHONE=+919876543210

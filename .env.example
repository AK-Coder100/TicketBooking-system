# ==============================================================================
# Multi-Tenant Ticket Booking Platform - Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:5000

# Security & Cryptographic Tokens
# CRITICAL: Generate a strong 64-character secret in production using: openssl rand -hex 32
SIGNING_SECRET=4f9b8c2d1e0a7f6e5d4c3b2a19087654321fedcba0987654321abcdef0123456
JWT_SECRET=super_secret_multi_tenant_jwt_signing_key_change_in_prod

# Database
DB_PATH=./data/ticket_platform.db

# ------------------------------------------------------------------------------
# CASHFREE PAYMENT GATEWAY (PG API v3 with Easy Split)
# ------------------------------------------------------------------------------
# Sandbox: https://sandbox.cashfree.com/pg | Production: https://api.cashfree.com/pg
CASHFREE_ENV=TEST
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Razorpay Route Multi-Party Split)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# DEFAULT BUSINESS RULES & SETTLEMENT PARAMETERS
# ------------------------------------------------------------------------------
# Default Super Admin Platform Fee per ticket in Paise (200 paise = ₹2.00)
DEFAULT_PLATFORM_COMMISSION_PAISE=200

# Payment Gateway Surcharge and GST % (Used when tenant passes fee to customer)
GATEWAY_SURCHARGE_PERCENT=2.0
GST_ON_FEE_PERCENT=18.0

# Concurrency Reservation Hold Lock Duration (in minutes)
RESERVATION_HOLD_MINUTES=10

# ------------------------------------------------------------------------------
# WHATSAPP NOTIFICATION SERVICE (Meta WhatsApp Cloud API)
# Note: Client/recipient phone numbers are entered dynamically at checkout before payment.
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_TEMPLATE_NAME=ticket_booking_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=verify_token_wa_2026
